# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# This is a Bun-first project — bun.lock is authoritative.
# npm/yarn/pnpm lockfiles are excluded to avoid drift.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Netlify — nitro's `netlify` preset writes build output into .netlify/.
# Scoped to the generated subpaths so tracked files in .netlify/ stay visible.
.netlify/functions-internal/
.netlify/edge-functions/
.netlify/deploy/
.netlify/state.json

# Environment files (NEVER commit real secrets)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
UPLOAD-CHECKLIST.txt
test-outputs.ts
