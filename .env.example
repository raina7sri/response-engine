# =============================================================================
# Customer Response Engine — environment variables
# =============================================================================
#
# The current implementation requires ZERO environment variables to run.
# Reasoning is deterministic (encoded), there are no external API calls,
# and there is no persistence layer.
#
# Any variables listed below are RESERVED for the production evolution
# (see docs/production-roadmap.md) and are not read by the code today.
# =============================================================================

# --- Stage 2 — model integration (reserved, not implemented) -----------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Stage 2 — retrieval / knowledge (reserved, not implemented) -------------
# VECTOR_DB_URL=
# VECTOR_DB_API_KEY=

# --- Stage 3 — observability (reserved, not implemented) ---------------------
# TELEMETRY_ENDPOINT=

# --- Stage 4 — authentication (reserved, not implemented) --------------------
# AUTH_ISSUER_URL=
# AUTH_CLIENT_ID=
